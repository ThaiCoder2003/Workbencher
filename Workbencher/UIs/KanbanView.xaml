    <UserControl x:Class="Workbencher.UIs.KanbanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Workbencher.UIs"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="Transparent">
    <Grid>
        <Grid Background="#F9F8FC" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#CDC1FF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.03" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0, 30,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Task Title" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtNewTitle" Width="400" Padding="8" BorderBrush="#4E217A" MaxLength="100"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Deadline" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DPDeadline" Width="200" Padding="8" BorderBrush="#4E217A"/>
                            </StackPanel>

                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Task Description / Execution Notes" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewDescription" Height="45" Padding="8" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="#4E217A"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="➕ Create Task Card" Click="CreateTask_Click" Background="#4E217A" Foreground="White" FontWeight="SemiBold" Padding="20,0" VerticalAlignment="Center" BorderThickness="0" Height="50">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Workspace Filter:" 
               Foreground="#64748B" 
               FontSize="14" 
               FontWeight="Medium" 
               VerticalAlignment="Center" 
               Margin="0,0,10,0"/>

                <ComboBox x:Name="CboWorkspaceFilter" 
                    Width="220" 
                    Height="32" 
                    VerticalContentAlignment="Center"
                    SelectionChanged="CboWorkspaceFilter_SelectionChanged">
                </ComboBox>
            </StackPanel>
            <Grid x:Name="KanbanBoardGrid" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#CDC1FF" CornerRadius="12" Margin="0,0,10,0" Padding="15" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📌 TO DO" FontSize="15" FontWeight="Bold" Foreground="#4E217A" Margin="5,0,0,15"/>
                        <ListBox Grid.Row="1" 
                                 x:Name="ToDoTasks"
                                 ItemsSource="{Binding ToDoTaskList}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 HorizontalContentAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 dd:DragDrop.UseDefaultDragAdorner="True"
                                 dd:DragDrop.UseDefaultEffectDataTemplate="True">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="dd:DragDrop.IsDragSource" Value="True"/>
                                    <Setter Property="dd:DragDrop.IsDropTarget" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=CboWorkspaceFilter, Path=SelectedIndex}" Value="0">
                                            <Setter Property="dd:DragDrop.IsDragSource" Value="False"/>
                                            <Setter Property="dd:DragDrop.IsDropTarget" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                                            Background="#FFFFFF" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="4,6" 
                                            Padding="12">
                                        <StackPanel>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Setter Property="Opacity" Value="0.0"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Button Content="Edit" Click="EditTask_Click" Tag="{Binding}" Width="45" Height="22" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="✕" Click="DeleteTask_Click" Tag="{Binding}" Width="24" Height="22" FontSize="11" FontWeight="Bold" Background="#EF4444" Foreground="White" BorderThickness="0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📅 " FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Deadline, StringFormat={}{0:MM/dd/yyyy}}" FontSize="11" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#CDC1FF" CornerRadius="12" Margin="0,0,10,0" Padding="15" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="⚡ IN PROGRESS" FontSize="15" FontWeight="Bold" Foreground="#4E217A" Margin="5,0,0,15"/>
                        <ListBox 
                            Grid.Row="1" 
                            x:Name="InProgressTasks"
                            ItemsSource="{Binding InProgressTaskList}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ScrollViewer.CanContentScroll="True"
                            dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                            dd:DragDrop.UseDefaultDragAdorner="True"
                            dd:DragDrop.UseDefaultEffectDataTemplate="True">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="dd:DragDrop.IsDragSource" Value="True"/>
                                    <Setter Property="dd:DragDrop.IsDropTarget" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=CboWorkspaceFilter, Path=SelectedIndex}" Value="0">
                                            <Setter Property="dd:DragDrop.IsDragSource" Value="False"/>
                                            <Setter Property="dd:DragDrop.IsDropTarget" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                                            Background="#FFFFFF" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="4,6" 
                                            Padding="12">
                                        <StackPanel>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Setter Property="Opacity" Value="0.0"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Button Content="Edit" Click="EditTask_Click" Tag="{Binding}" Width="45" Height="22" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="✕" Click="DeleteTask_Click" Tag="{Binding}" Width="24" Height="22" FontSize="11" FontWeight="Bold" Background="#EF4444" Foreground="White" BorderThickness="0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📅 " FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Deadline, StringFormat={}{0:MM/dd/yyyy}}" FontSize="11" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#CDC1FF" CornerRadius="12" Margin="0,0,10,0" Padding="15" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="✅ COMPLETED" FontSize="15" FontWeight="Bold" Foreground="#4E217A" Margin="5,0,0,15"/>
                        <ListBox Grid.Row="1" 
                                x:Name="CompletedTasks"
                                 ItemsSource="{Binding CompletedTaskList}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 HorizontalContentAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 dd:DragDrop.UseDefaultDragAdorner="True"
                                 dd:DragDrop.UseDefaultEffectDataTemplate="True">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="dd:DragDrop.IsDragSource" Value="True"/>
                                    <Setter Property="dd:DragDrop.IsDropTarget" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=CboWorkspaceFilter, Path=SelectedIndex}" Value="0">
                                            <Setter Property="dd:DragDrop.IsDragSource" Value="False"/>
                                            <Setter Property="dd:DragDrop.IsDropTarget" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                                            Background="#FFFFFF" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="4,6" 
                                            Padding="12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Setter Property="Opacity" Value="0.0"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Button Content="Edit" Click="EditTask_Click" Tag="{Binding}" Width="45" Height="22" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="✕" Click="DeleteTask_Click" Tag="{Binding}" Width="24" Height="22" FontSize="11" FontWeight="Bold" Background="#EF4444" Foreground="White" BorderThickness="0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📅 " FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Deadline, StringFormat={}{0:MM/dd/yyyy}}" FontSize="11" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="#FEF2F2" CornerRadius="12" BorderBrush="#FCA5A5" BorderThickness="1.5" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Board Column Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🚨 Overdue Deadlines" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                        <Border Background="#EF4444" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <!-- Binds to the item count of your Due collection -->
                            <TextBlock Text="{Binding DueTasks.Count, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Scrollable Read-Only List Layout -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <!-- IsHitTestVisible="False" intercepts and drops ALL mouse clicks/inputs, making it uneditable -->
                        <ItemsControl x:Name="IcDueTasks" ItemsSource="{Binding DueTasks}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Horizontal card item element layout -->
                                    <Border Background="White" Width="260" Height="90" CornerRadius="8" Padding="12" Margin="0,0,12,0" BorderBrush="#FEE2E2" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="#0F172A"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,4" TextTrimming="CharacterEllipsis"/>

                                            <!-- Missed date indicator tag -->
                                            <TextBlock Grid.Row="2" Text="{Binding Deadline, StringFormat='Missed on: \{0:d\}'}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
