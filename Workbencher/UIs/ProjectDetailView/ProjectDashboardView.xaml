<UserControl x:Class="Workbencher.UIs.ProjectDetailView.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
            <Border Background="#CDC1FF" CornerRadius="8" Padding="20" Margin="0,0,15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Tasks" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtTotalTasks" Text="0" Foreground="#0F172A" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#CDC1FF" CornerRadius="8" Padding="20" Margin="0,0,15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Project Completion" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtCompletionPercentage" Text="0%" Foreground="#4E217A" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    <ProgressBar x:Name="ProgressProject" Height="6" Margin="0,10,0,0" Background="#F1F5F9" Foreground="#4E217A"/>
                </StackPanel>
            </Border>

            <Border Background="#CDC1FF" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Team Size" Foreground="#64748B" FontSize="13" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtTeamSize" Text="0 Members" Foreground="#0F172A" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1" Margin="0,0,0,10" Height="150">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                Background="#CDC1FF"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,10,0"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Project Overview"
                       FontSize="16"
                       FontWeight="Bold"/>

                    <TextBlock Text="Description"
                       Margin="0,8,0,5"
                       FontWeight="SemiBold"/>

                    <TextBlock x:Name="TxtProjectDescription"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCreatedDate"
                       Margin="0,0,0,5"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                    />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
            Background="#CDC1FF"
            CornerRadius="8"
            Padding="20"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            >
                <StackPanel>
                    <Button x:Name="BtnOpenChat"
                    Content="💬 Open Chat"
                    Margin="0,0,0,20" Click="BtnOpenChat_Click"/>

                    <Button x:Name="BtnInvite"
                    Content="👤 Invite Member"
                    Margin="0,0,0,20" Click="BtnInvite_Click"/>

                    <Button x:Name="BtnLeave"
                    Content="🚪 Leave Project"
                    Background="#FEE2E2"
                    Foreground="#B91C1C" Click="BtnLeave_Click"/>

                </StackPanel>

            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#CDC1FF" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Height="150">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="505*"/>
                    <ColumnDefinition Width="21*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="👥 Project Team Roster" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,15" Grid.ColumnSpan="2"/>

                <ListView x:Name="LvTeamRoster" BorderThickness="0" Background="White" Grid.ColumnSpan="2" Margin="0,36,0,0" Grid.RowSpan="2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Email" DisplayMemberBinding="{Binding User.Email}" Width="180"/>
                            <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role}" Width="120"/>
                            <GridViewColumn Header="Joined Date" DisplayMemberBinding="{Binding JoinedAt, StringFormat=\{0:d\}}" Width="140"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
