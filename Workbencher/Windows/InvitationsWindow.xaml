<Window x:Class="Workbencher.Windows.InvitationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pending Project Invitations" Height="450" Width="550" 
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="✉️ Incoming Workspace Invitations" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Review, accept, or decline pending requests below." FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="LstInvitations" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10" Width="490">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Project.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Invited by: " FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Sender.Email}" FontSize="12" FontWeight="Medium" Foreground="#475569"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Accept" Click="Accept_Click" Tag="{Binding}" Background="#10B981" Foreground="White" FontWeight="Medium" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Decline" Click="Decline_Click" Tag="{Binding}" Background="#EF4444" Foreground="White" FontWeight="Medium" Padding="12,6" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <Border x:Name="MsgBorder" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                <TextBlock x:Name="TxtMsg" 
                                           Text="{Binding InviteMessage}" 
                                           FontSize="12" Foreground="#334155" 
                                           TextWrapping="Wrap" 
                                           FontStyle="Italic" 
                                           Margin="10,8,10,8" 
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding InviteMessage}" Value="{x:Null}">
                            <Setter TargetName="MsgBorder" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InviteMessage}" Value="">
                            <Setter TargetName="MsgBorder" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                    
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>