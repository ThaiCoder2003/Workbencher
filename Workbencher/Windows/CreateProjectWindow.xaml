<Window x:Class="Workbencher.Windows.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Workspace" Height="340" Width="420" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" Foreground="#1E293B">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📁 Create New Project" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="Set up a collaborative workspace for your team." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Project Name" FontWeight="Medium" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtProjectName" Height="32" VerticalContentAlignment="Center" Padding="5,0" Background="White" BorderBrush="#CBD5E1"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Description (Optional)" FontWeight="Medium" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="TxtProjectDescription" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CBD5E1"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Height="32" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Create Project" Click="Create_Click" Width="120" Height="32" Background="#be39f7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>